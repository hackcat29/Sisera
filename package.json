{
  "name": "sisera",
  "version": "0.2.0",
  "private": true,
  "description": "Institutional multi-asset trading operating system",
  "packageManager": "pnpm@9.0.0",
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "build": "turbo run build --cache-dir=.turbo/cache",
    "dev": "node scripts/run-local.mjs all",
    "dev:web": "node scripts/run-local.mjs web",
    "dev:api": "node scripts/run-local.mjs api",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "db:migrate": "node scripts/migrate.mjs",
    "test": "turbo run test --cache-dir=.turbo/cache",
    "typecheck": "turbo run typecheck --cache-dir=.turbo/cache",
    "buybot": "pnpm --filter @sisera/api exec tsx src/buybot-cli.ts watch",
    "buybot:test": "pnpm --filter @sisera/api exec tsx src/buybot-cli.ts test",
    "buybot:chatid": "pnpm --filter @sisera/api exec tsx src/buybot-cli.ts chatid",
    "buybot:stickers": "pnpm --filter @sisera/api exec tsx src/buybot-cli.ts stickers",
    "stickers:render": "node scripts/render-stickers.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "postgres": "^3.4.5",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2"
  }
}

# ==========================================
# SISERA PRODUCTION ENVIRONMENT CONFIGURATION
# Location on Contabo VPS: /opt/sisera/.env.production
# ==========================================

# --- DOMAIN & PUBLIC URLS ---
SISERA_API_URL=http://127.0.0.1:4200
SISERA_PUBLIC_URL=https://sisera.xyz
NEXT_PUBLIC_PRIVY_APP_ID=

# --- AUTH & PRIVY ---
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# --- SYSTEM & LOGGING ---
API_PORT=4200
PORT=3100
NODE_ENV=production
LOG_LEVEL=info

# --- DATABASE (POSTGRESQL) ---
POSTGRES_DB=sisera
POSTGRES_USER=sisera
POSTGRES_PASSWORD=your_ultra_secure_postgres_password_here
DATABASE_URL=postgresql://sisera:your_ultra_secure_postgres_password_here@127.0.0.1:5432/sisera
SISERA_LIVE_SOLANA_ENABLED=true
SISERA_LIVE_PREDICTIONS_ENABLED=true
SISERA_LIVE_BINANCE_ENABLED=true

# --- PLATFORM RUNTIME (policies, agents, launches) ---
# Background evaluation of conversational policies (30s), agents (60s) and event collection (15m).
SISERA_SCHEDULER_ENABLED=true
# Real-money capabilities are on by default; set a flag to false to pause it.
SISERA_LIVE_LAUNCHES_ENABLED=true
SISERA_LIVE_AGENTS_ENABLED=true
# Server-side signing for wallets whose owners delegated a Privy session signer.
SISERA_DELEGATED_SIGNING_ENABLED=true
PRIVY_AUTHORIZATION_PRIVATE_KEY=
# Optional wallet that receives Meteora DBC partner fees for launches made in Sisera.
SISERA_DBC_PARTNER_WALLET=
# SEC EDGAR asks every client to identify itself with a contact.
SEC_EDGAR_USER_AGENT=Sisera market intelligence ops@sisera.xyz

# --- REDIS CACHE ---
REDIS_URL=redis://127.0.0.1:6379

# --- SOLANA & MARKET INTEGRATIONS ---
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your_helius_key
HELIUS_API_KEY=your_helius_key
HELIUS_WEBHOOK_SECRET=your_helius_webhook_secret
JUPITER_API_KEY=your_jupiter_api_key
PYTH_API_KEY=your_pyth_core_hermes_key
PYTH_HERMES_URL=https://pyth.dourolabs.app/hermes
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key
CLAWPUMP_API_KEY=
RELAY_API_KEY=
PRESTOCKS_BASE_URL=https://prestocks.com
BINANCE_SPOT_BASE_URL=https://data-api.binance.vision
PANTA_API_BASE_URL=https://live-api.panta.market/api/v1
# Use a pk_live_ key for actual markets; pk_test_ keys return sandbox fixtures.
PANTA_API_KEY=

# --- INTELLIGENCE & NEWS FEEDS ---
GNEWS_API_KEY=
FINNHUB_API_KEY=
MARKETAUX_API_KEY=
OPENROUTER_API_KEY=
SISERA_INTELLIGENCE_MODEL=nvidia/nemotron-3-super-120b-a12b:free
SISERA_X_BEARER_TOKEN=
SISERA_X_TRACKED_ACCOUNTS=CoinDesk,TheBlock__,solana,ethereum,HyperliquidX
SISERA_X_MAX_DAILY_SPEND_USD=0
SISERA_TELEGRAM_NEWS_CHANNELS=cointelegraph,decryptmedia,WuBlockchain
SISERA_DISCORD_BOT_TOKEN=
SISERA_DISCORD_CHANNEL_IDS=

# --- CLOUDFLARE ZERO TRUST TUNNEL ---
# Generated from Cloudflare Dashboard > Zero Trust > Networks > Tunnels
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here
